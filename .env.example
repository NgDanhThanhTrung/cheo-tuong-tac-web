# MongoDB Connection String (BẮT BUỘC)
# Lấy từ MongoDB Atlas hoặc Render MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cheo-tuong-tac

# Admin Password (BẮT BUỘC)
# Dùng để truy cập trang admin tại /admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Port (Optional - mặc định 5000)
PORT=5000
